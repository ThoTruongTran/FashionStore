<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FashionStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" data-auth="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">
    <form id="afForm" class="d-none">@Html.AntiForgeryToken()</form>
    <header class="sticky-top bg-white shadow-sm">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">FASHION<span class="text-danger">STORE</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index">Tất cả</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index" asp-route-gender="Nam">Nam</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index" asp-route-gender="Nữ">Nữ</a></li>
                        <li class="nav-item"><a class="nav-link text-danger" asp-area="" asp-controller="Product" asp-action="Index" asp-route-sort="price_asc">Sale</a></li>
                    </ul>
                    <form class="d-flex me-lg-3 my-2 my-lg-0" asp-area="" asp-controller="Product" asp-action="Index" method="get">
                        <input name="keyword" class="form-control form-control-sm me-2" placeholder="Tìm sản phẩm..." />
                        <button class="btn btn-sm btn-dark"><i class="bi bi-search"></i></button>
                    </form>
                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Wishlist" asp-action="Index" title="Yêu thích"><i class="bi bi-heart fs-5"></i></a></li>
                        <li class="nav-item">@await Component.InvokeAsync("CartCount")</li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-person-circle"></i> @User.Identity.Name</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">Thông tin cá nhân</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Wishlist" asp-action="Index">Sản phẩm yêu thích</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Order" asp-action="Index">Đơn hàng của tôi</a></li>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang quản trị</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button class="dropdown-item text-danger">Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                            <li class="nav-item"><a class="btn btn-sm btn-dark ms-lg-2" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @RenderBody()
    </main>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container d-flex flex-column flex-md-row justify-content-between">
            <div><strong>FASHIONSTORE</strong><br /><small class="text-secondary">Thời trang cho mọi phong cách</small></div>
            <small class="text-secondary align-self-end">© 2026 FashionStore - Bài tập lớn ASP.NET Core MVC</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>