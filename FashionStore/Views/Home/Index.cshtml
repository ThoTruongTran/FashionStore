@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

@if (Model.Banners.Any())
{
    <div id="banner" class="carousel slide mb-5" data-bs-ride="carousel">
        <div class="carousel-inner rounded-3 overflow-hidden shadow-sm">
            @for (int i = 0; i < Model.Banners.Count; i++)
            {
                var b = Model.Banners[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <a href="@(b.LinkUrl ?? "#")"><img src="@b.ImageUrl" class="d-block w-100" alt="@b.Title" /></a>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#banner" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
        <button class="carousel-control-next" type="button" data-bs-target="#banner" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
    </div>
}

<section class="mb-5">
    <h2 class="h4 section-title">Danh mục nổi bật</h2>
    <div class="row g-3">
        @foreach (var c in Model.Categories)
        {
            <div class="col-6 col-md-3">
                <a class="category-tile" asp-controller="Product" asp-action="Index" asp-route-categoryId="@c.Id">@c.Name</a>
            </div>
        }
    </div>
</section>

<section class="mb-5">
    <h2 class="h4 section-title">Hàng mới về</h2>
    <div class="row g-3">
        @foreach (var p in Model.NewProducts)
        {
            <div class="col-6 col-md-4 col-lg-3"><partial name="_ProductCard" model="p" /></div>
        }
    </div>
</section>

@if (Model.SaleProducts.Any())
{
    <section class="mb-5">
        <h2 class="h4 section-title text-danger">Đang giảm giá</h2>
        <div class="row g-3">
            @foreach (var p in Model.SaleProducts)
            {
                <div class="col-6 col-md-4 col-lg-3"><partial name="_ProductCard" model="p" /></div>
            }
        </div>
    </section>
}