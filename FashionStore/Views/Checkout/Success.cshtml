@model Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}
<div class="text-center py-5">
    <i class="bi bi-check-circle-fill text-success display-1"></i>
    <h1 class="h3 mt-3">Đặt hàng thành công!</h1>
    <p>Mã đơn hàng của bạn: <strong>@Model.OrderCode</strong></p>
    <p>Tổng thanh toán: <strong class="text-danger">@Model.TotalAmount.ToVnd()</strong></p>
    <a class="btn btn-dark me-2" asp-controller="Order" asp-action="Details" asp-route-id="@Model.Id">Xem đơn hàng</a>
    <a class="btn btn-outline-dark" asp-controller="Home" asp-action="Index">Tiếp tục mua sắm</a>
</div>