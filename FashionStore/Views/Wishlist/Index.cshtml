@model List<Product>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}
<h1 class="h3 mb-4"><i class="bi bi-heart-fill text-danger"></i> Sản phẩm yêu thích</h1>
@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-heart display-3 text-muted"></i>
        <p class="mt-3 text-muted">Bạn chưa thích sản phẩm nào</p>
        <a class="btn btn-dark" asp-controller="Product" asp-action="Index">Khám phá sản phẩm</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model)
        {
            <div class="col-6 col-md-4 col-lg-3" data-wish-item><partial name="_ProductCard" model="p" /></div>
        }
    </div>
}