@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        @if (TempData["DevLink"] is string devLink)
        {
            <div class="alert alert-warning small">
                <strong>[Chế độ Development, chưa cấu hình SMTP]</strong><br />
                Liên kết đặt lại mật khẩu: <a href="@devLink">bấm vào đây</a>
            </div>
        }
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 text-center mb-2">Quên mật khẩu</h1>
                <p class="text-muted small text-center">Nhập email đã đăng ký, chúng tôi sẽ gửi liên kết đặt lại mật khẩu.</p>
                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-dark w-100">Gửi liên kết</button>
                </form>
                <p class="text-center mt-3 mb-0 small"><a asp-action="Login">← Quay lại đăng nhập</a></p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}