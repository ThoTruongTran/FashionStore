@model Cart
@{
    ViewData["Title"] = "Giỏ hàng";
}
<h1 class="h3 mb-4">Giỏ hàng của bạn</h1>

@if (!Model.Items.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-bag-x display-3 text-muted"></i>
        <p class="mt-3 text-muted">Giỏ hàng đang trống</p>
        <a class="btn btn-dark" asp-controller="Product" asp-action="Index">Tiếp tục mua sắm</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light"><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                var v = item.ProductVariant!;
                                var p = v.Product!;
                                var img = p.Images.OrderByDescending(i => i.IsMain).FirstOrDefault()?.ImageUrl ?? "https://placehold.co/64x84";
                                <tr>
                                    <td>
                                        <div class="d-flex gap-2 align-items-center">
                                            <img src="@img" class="cart-img rounded" alt="" />
                                            <div>
                                                <a class="text-dark fw-semibold text-decoration-none" asp-controller="Product" asp-action="Details" asp-route-slug="@p.Slug">@p.Name</a>
                                                <div class="small text-muted">@v.Color?.Name / @v.Size?.Name</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@v.FinalPrice.ToVnd()</td>
                                    <td>
                                        <form asp-action="Update" method="post">
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="0" max="@v.StockQuantity"
                                                   class="form-control form-control-sm" style="width:80px" onchange="this.form.submit()" />
                                        </form>
                                    </td>
                                    <td class="fw-semibold">@((item.Quantity * v.FinalPrice).ToVnd())</td>
                                    <td>
                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h6">Tóm tắt đơn hàng</h2>
                    <div class="d-flex justify-content-between my-3"><span>Tạm tính</span><strong>@Model.Total.ToVnd()</strong></div>
                    <small class="text-muted d-block mb-3">Phí vận chuyển tính ở bước thanh toán</small>
                    <a class="btn btn-dark w-100" asp-controller="Checkout" asp-action="Index">Tiến hành thanh toán</a>
                    <a class="btn btn-link w-100 mt-1" asp-controller="Product" asp-action="Index">Tiếp tục mua sắm</a>
                </div>
            </div>
        </div>
    </div>
}