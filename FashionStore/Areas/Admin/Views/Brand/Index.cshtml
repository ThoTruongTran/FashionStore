@* Brands/Index.cshtml *@
@model List<Brand>
@{
    ViewData["Title"] = "Thương hiệu"; var counts = (Dictionary<int, int>)ViewBag.Counts;
}
<div class="d-flex justify-content-between mb-3"><h1 class="h4">Thương hiệu</h1><a asp-action="Create" class="btn btn-dark btn-sm"><i class="bi bi-plus-lg"></i> Thêm thương hiệu</a></div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Logo</th><th>Tên</th><th>Mô tả</th><th>Số SP</th><th></th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@if (!string.IsNullOrEmpty(b.LogoUrl)) {
                        <img src="@b.LogoUrl" style="height:36px" alt="" />
                    } else
                    {

                        <span class="text-muted">—</span>
                    }
</td>
                    <td class="fw-semibold">@b.Name</td>
                    <td class="small text-muted">@b.Description</td>
                    <td>@counts.GetValueOrDefault(b.Id)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@b.Id"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa thương hiệu này?')">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>
</div>