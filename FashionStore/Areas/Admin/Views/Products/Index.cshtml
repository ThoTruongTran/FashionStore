@model List<Product>
@{
    ViewData["Title"] = "Sản phẩm"; var cur = (string?)ViewBag.Status;
}
<div class="d-flex justify-content-between mb-3">
    <h1 class="h4">Sản phẩm <small class="text-muted fs-6">(@ViewBag.Total)</small></h1>
    <a asp-action="Create" class="btn btn-dark btn-sm"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="keyword" value="@ViewBag.Keyword" class="form-control form-control-sm" placeholder="Tìm theo tên..." /></div>
    <div class="col-md-3"><select name="categoryId" asp-items="(SelectList)ViewBag.Categories" class="form-select form-select-sm"><option value="">Tất cả danh mục</option></select></div>
    <div class="col-md-3">
        <select name="status" class="form-select form-select-sm">
            <option value="">Tất cả trạng thái</option>
            <option value="active" selected="@(cur == "active")">Đang hiển thị</option>
            <option value="hidden" selected="@(cur == "hidden")">Đang ẩn</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-sm btn-dark w-100">Lọc</button></div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Ảnh</th><th>Sản phẩm</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var img = p.Images.OrderByDescending(i => i.IsMain).FirstOrDefault()?.ImageUrl ?? "https://placehold.co/48x64";
                    var stock = p.Variants.Sum(v => v.StockQuantity);
                    <tr>
                        <td><img src="@img" class="admin-row-img rounded" alt="" /></td>
                        <td><div class="fw-semibold">@p.Name</div><small class="text-muted">@p.Category?.Name · @p.Brand?.Name · @p.Variants.Count biến thể</small></td>
                        <td>@p.SalePrice.ToVnd() @if (p.DiscountPercent > 0) {
                        <span class="badge bg-danger">-@p.DiscountPercent%</span>
                    }
</td>
                    <td>@if (stock == 0) {
                    <span class="badge bg-danger">Hết hàng</span>
                                        } else
                    {

                        <span>@stock</span>
                    }
</td>
                    <td><span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "Hiển thị" : "Ẩn")</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@p.Id" title="Sửa"><i class="bi bi-pencil"></i></a>
                        <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary" title="Ẩn/Hiện"><i class="bi @(p.IsActive ? "bi-eye-slash" : "bi-eye")"></i></button></form>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa sản phẩm này?')"><button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button></form>
                    </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model="(PagingInfo)ViewBag.Paging" />