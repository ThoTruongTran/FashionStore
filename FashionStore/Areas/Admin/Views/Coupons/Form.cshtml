@model Coupon
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm mã giảm giá" : "Sửa mã giảm giá";
}
<h1 class="h4 mb-3">@ViewData["Title"]</h1>
<div class="card shadow-sm" style="max-width:700px">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="Code" class="form-label">Mã (chữ in hoa, không dấu)</label><input asp-for="Code" class="form-control text-uppercase" /></div>
                <div class="col-md-6">
                    <label asp-for="DiscountType" class="form-label">Loại giảm</label>
                    <select asp-for="DiscountType" class="form-select"><option value="Percent">Giảm theo %</option><option value="FixedAmount">Giảm số tiền cố định (₫)</option></select>
                </div>
                <div class="col-md-6"><label asp-for="DiscountValue" class="form-label">Giá trị giảm</label><input asp-for="DiscountValue" type="number" step="any" min="0" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="MinOrderAmount" class="form-label">Đơn tối thiểu (₫)</label><input asp-for="MinOrderAmount" type="number" step="any" min="0" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="StartDate" class="form-label">Từ ngày</label><input asp-for="StartDate" type="date" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="EndDate" class="form-label">Đến hết ngày</label><input asp-for="EndDate" type="date" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="MaxUsage" class="form-label">Số lượt dùng tối đa (0 = không giới hạn)</label><input asp-for="MaxUsage" type="number" min="0" class="form-control" /></div>
                <div class="col-md-6 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Đang bật</label></div></div>
            </div>
            <div class="mt-3"><button class="btn btn-dark">Lưu</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div>
        </form>
    </div>
</div>