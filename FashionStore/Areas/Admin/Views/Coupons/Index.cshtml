@model List<Coupon>
@{
    ViewData["Title"] = "Mã giảm giá";
}
<div class="d-flex justify-content-between mb-3"><h1 class="h4">Mã giảm giá</h1><a asp-action="Create" class="btn btn-dark btn-sm"><i class="bi bi-plus-lg"></i> Thêm mã</a></div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Mã</th><th>Mức giảm</th><th>Đơn tối thiểu</th><th>Đã dùng</th><th>Thời hạn</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var now = DateTime.Now;
                    var (label, badge) =
                    !c.IsActive ? ("Đã tắt", "bg-secondary") :
                    now >= c.EndDate.Date.AddDays(1) ? ("Hết hạn", "bg-dark") :
                    now < c.StartDate.Date ? ("Chưa bắt đầu", "bg-info text-dark") :
                    (c.MaxUsage > 0 && c.UsedCount >= c.MaxUsage) ? ("Hết lượt", "bg-warning text-dark") :
                    ("Đang chạy", "bg-success");
                    <tr>
                        <td class="fw-bold">@c.Code</td>
                        <td>@(c.DiscountType == DiscountType.Percent ? $"{c.DiscountValue:0.##}%" : c.DiscountValue.ToVnd())</td>
                        <td>@c.MinOrderAmount.ToVnd()</td>
                        <td>@c.UsedCount / @(c.MaxUsage == 0 ? "∞" : c.MaxUsage.ToString())</td>
                        <td class="small">@c.StartDate.ToString("dd/MM/yyyy") - @c.EndDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge @badge">@label</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa mã này?')">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>