@* Banners/Index.cshtml *@
@model List<Banner>
@{
    ViewData["Title"] = "Banner";
}
<div class="d-flex justify-content-between mb-3"><h1 class="h4">Banner trang chủ</h1><a asp-action="Create" class="btn btn-dark btn-sm"><i class="bi bi-plus-lg"></i> Thêm banner</a></div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Ảnh</th><th>Tiêu đề</th><th>Liên kết</th><th>Thứ tự</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td><img src="@b.ImageUrl" style="height:50px;width:150px;object-fit:cover" class="rounded" alt="" /></td>
                        <td class="fw-semibold">@b.Title</td>
                        <td class="small text-muted">@b.LinkUrl</td>
                        <td>@b.SortOrder</td>
                        <td><span class="badge @(b.IsActive ? "bg-success" : "bg-secondary")">@(b.IsActive ? "Hiển thị" : "Ẩn")</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@b.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa banner này?')">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>